.DS_Store

# Editor noise
*.swp
*~
.idea/
.vscode/

# Homebrew tap working tree (kept locally only)
Casks/.brew/

# OMC / OMX runtime state and internal planning docs — never published.
# .omc/plans/ contains internal consensus drafts, agent reviews, and
# trade-off discussions that are not appropriate for a public OSS repo.
.omc/
.omx/

# Claude Code session state — local only, never committed.
.claude/

# Vercel local link state (project + org IDs)
.vercel/

# Python tooling (Brandkit, scripts)
__pycache__/
*.pyc
.venv/

# Internal design handoff bundles (Claude Design exports + chat transcripts).
# Useful as a local reference but not appropriate for the public repo.
design-source/

# Marketing drafts — local-only copy decks for LinkedIn / Threads / X.
marketing/

# Claude Code repo guide — local-only AI assistant context.
CLAUDE.md

# Promo video / hyperframe exports — local working bundle, not part of
# the shipping repo (sits at ~tens of MB, unrelated to source).
hyperframes/

# Threads / X publishing tooling — local-only automation, same category
# as marketing/ (copy decks). Holds API tokens and post drafts.
Scripts/x-publish/

.dbg/

debug*
